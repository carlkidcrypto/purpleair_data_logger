{
  "instance_name": "purpleair-minimal",
  "queue_capacity": 4096,
  "max_poll_cycles": 0,
  "log_level": "info",
  "duts": [
    {
      "name": "sensor-outdoor-01",
      "dut_ip": "127.0.0.1",
      "poll_interval_ms": 2000,
      "enabled": true,
      "purpleair": {
        "mode": "stub",
        "version": "v1",
        "api_read_key": "",
        "sensor_index": 131075,
        "endpoint": "single"
      },
      "metrics": [
        {
          "name": "pm2.5_atm",
          "field": "pm2.5_atm",
          "oid": "pm2.5_atm",
          "operation": "get",
          "max_repeaters": 25
        },
        {
          "name": "humidity",
          "field": "humidity",
          "oid": "humidity",
          "operation": "get",
          "max_repeaters": 25
        }
      ]
    }
  ],
  "sinks": {
    "sqlite": {
      "enabled": true,
      "path": "./data/purpleair_minimal.sqlite3",
      "batch_commit_size": 32,
      "busy_timeout_ms": 5000,
      "wal_mode": true
    }
  },
  "gui": {
    "frontend": "auto",
    "host": "127.0.0.1",
    "port": 8765,
    "refresh_interval_ms": 1000,
    "theme": "dark",
    "locale": "en",
    "window_title": "PurpleAir Data Logger Studio"
  }
}
