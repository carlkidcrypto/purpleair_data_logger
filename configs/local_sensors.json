{
  "instance_name": "purpleair-local-lan",
  "queue_capacity": 4096,
  "max_poll_cycles": 0,
  "log_level": "info",
  "duts": [
    {
      "name": "lan-sensor-patio",
      "dut_ip": "192.168.1.50",
      "poll_interval_ms": 5000,
      "enabled": true,
      "purpleair": {
        "mode": "local",
        "version": "v1",
        "endpoint": "local"
      },
      "metrics": [
        {
          "name": "pm2_5_atm",
          "field": "pm2_5_atm",
          "oid": "pm2_5_atm",
          "operation": "local",
          "max_repeaters": 25
        },
        {
          "name": "current_temp_f",
          "field": "current_temp_f",
          "oid": "current_temp_f",
          "operation": "local",
          "max_repeaters": 25
        },
        {
          "name": "current_humidity",
          "field": "current_humidity",
          "oid": "current_humidity",
          "operation": "local",
          "max_repeaters": 25
        }
      ]
    }
  ],
  "sinks": {
    "sqlite": {
      "enabled": true,
      "path": "./data/purpleair_local.sqlite3",
      "batch_commit_size": 32,
      "busy_timeout_ms": 5000,
      "wal_mode": true
    }
  }
}
