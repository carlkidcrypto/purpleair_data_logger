{
  "name": "matterbridge-purpleair",
  "version": "0.1.0",
  "private": true,
  "description": "Matterbridge plugin that exposes PurpleAir Matter JSON as bridged Matter air quality sensors",
  "homepage": "https://github.com/carlkidcrypto/purpleair_data_logger/tree/main/matterbridge-purpleair",
  "license": "MIT",
  "author": "carlkidcrypto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carlkidcrypto/purpleair_data_logger.git",
    "directory": "matterbridge-purpleair"
  },
  "files": [
    "dist",
    "README.md",
    "Requirements.rst",
    "*.config.json",
    "*.schema.json"
  ],
  "type": "module",
  "main": "dist/module.js",
  "types": "dist/module.d.ts",
  "exports": {
    ".": {
      "import": "./dist/module.js",
      "types": "./dist/module.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "node -e \"import('node:fs').then(({ rmSync }) => rmSync('dist', { recursive: true, force: true }))\"",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint --disable-nested-config",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "dev:link": "npm link matterbridge --no-save"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0 || >=22.13.0 <23.0.0 || >=24.0.0 <25.0.0 || >=26.0.0 <27.0.0"
  }
}
